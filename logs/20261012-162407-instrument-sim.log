 endcase end
 endfunction
 integer k;
 always @(posedge clk)begin
  if(!reset_n)begin
   state<=IDLE;index<=0;sample<=0;active<=0;phase_reg<=0;level_reg<=0;gate_frame<=0;sum<=0;frame_active<=0;
